{
  "name": "todo_app",
  "version": "1.1.0",
  "author": "Harshit Mago",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.4.0",
    "expo": "~56.0.8",
    "expo-calendar": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist -t true",
    "desktop": "electron electron/main.js",
    "desktop:build": "npm run build:web && electron-builder --win",
    "desktop:dir": "npm run build:web && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.learnplan.desktop",
    "productName": "To Do",
    "copyright": "Copyright © 2026 To Do",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signtoolOptions": {
        "publisherName": "Harshit Mago"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "To Do",
      "artifactName": "${productName} Setup.${ext}"
    }
  },
  "private": true
}
